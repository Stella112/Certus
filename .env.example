# Copy to .env and fill. NEVER commit the real .env.
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=            # from Cleanverse onboarding email; sent as the api-id header
CLEANVERSE_API_KEY=           # Base64 AES key; used LOCALLY only, never transmitted

# Monad testnet (confirmed live 2026-08-08: cast chain-id -> 10143)
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_EXPLORER_URL=https://testnet.monadscan.com
DEPLOYER_PRIVATE_KEY=         # throwaway demo deployer only, NEVER a real-funds key
CERTUS_AGENT_PRIVATE_KEY=      # throwaway agent signing key for local demo; never use a production key here
CERTUS_AGENT_PROVIDER=anthropic # anthropic or openai
ANTHROPIC_API_KEY=              # server-side Claude API key; never expose in the browser
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=                 # optional alternative provider
CERTUS_AGENT_MODEL=gpt-5.6-terra # used when CERTUS_AGENT_PROVIDER=openai
CERTUS_OPERATOR_TOKEN=       # long random bearer token required by production mutation/audit routes

# Local development uses SQLite with prisma/schema.prisma.
# Vercel uses prisma/schema.postgres.prisma; replace this with the pooled
# PostgreSQL DATABASE_URL supplied by Neon/Vercel Postgres.
DATABASE_URL="file:./dev.db"

# --- Legacy single-chain probe settings (not used by the Certus app registry) ---
# Application networks and verified assets live in config/chains.json.
CHAIN_NAME=base
CHAIN_ID=84532
RPC_URL=https://base-sepolia-rpc.publicnode.com
RPC_FALLBACK_URL=https://base-sepolia.drpc.org
EXPLORER_URL=https://sepolia.basescan.org
ORIGIN_TOKEN=0x543b96420d072BF587B63C41C0B0922762E986Ce
ATOKEN=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
TOKEN_DECIMALS=6

# Which configured chain the seed/demo uses. Must be hackathonEligible.
DEFAULT_CHAIN=monad
