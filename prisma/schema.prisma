// Certus audit store.
// SQLite for the hackathon deployment; Postgres-ready via Prisma (swap the provider).
// AuditEvent is APPEND-ONLY: there is no update or delete path in src/lib/audit/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Intent {
  id        String @id @default(cuid())
  chain     String @default("monad") // typed registry key, required for multi-chain settlement context
  type      String // MILESTONE | BATCH | RECURRING | LINK
  senderCvi String // sender wallet address (the A-Pass holder)
  asset     String // A-Token address (aUSDC)
  amount    String // base units as a decimal STRING. never a float.
  status    String // DRAFT|ACTIVE|FROZEN|COMPLETED|REJECTED
  policyId  String // PERMISSIVE | STANDARD | STRICT
  privacyMode String @default("PUBLIC") // PUBLIC|PRIVATE_METADATA
  yieldMode   Boolean @default(false) // optional testnet yield-protected escrow
  purposeType String? // INVOICE|PURCHASE_ORDER|CONTRACT|MILESTONE|PAYROLL|OTHER
  purposeReference String? // human reference, never a secret document
  purposeHash String? // hash of the off-chain proof, safe to audit and compare

  legs      Leg[]
  events    AuditEvent[]
  subscription Subscription?
  paymentLink  PaymentLink?
  createdAt DateTime @default(now())

  @@index([senderCvi])
  @@index([chain])
  @@index([status])
}

model Subscription {
  id              String   @id @default(cuid())
  intentId        String   @unique
  intent          Intent   @relation(fields: [intentId], references: [id], onDelete: Cascade)
  recipientCvi    String
  amount          String
  intervalSeconds Int
  nextEpochAt     DateTime
  nextLegSequence Int      @default(1)
  status          String   @default("ACTIVE") // ACTIVE|HALTED|COMPLETED
  lastProcessedAt DateTime?
  createdAt       DateTime @default(now())

  @@index([status, nextEpochAt])
  @@index([recipientCvi])
}

model PaymentLink {
  id           String   @id @default(cuid())
  slug         String   @unique
  intentId     String   @unique
  intent       Intent   @relation(fields: [intentId], references: [id], onDelete: Cascade)
  recipientCvi String
  amount       String
  status       String   @default("ACTIVE") // ACTIVE|PAID|EXPIRED|DISABLED
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([status])
}

model AgentMandate {
  id                   String   @id @default(cuid())
  name                 String
  principalAddress     String
  agentAddress         String
  chain                String   @default("monad")
  policyId             String
  perTransactionLimit  String
  dailyLimit           String
  expiresAt            DateTime?
  status               String   @default("ACTIVE") // ACTIVE|REVOKED|EXPIRED
  signature            String
  createdAt            DateTime @default(now())

  @@index([principalAddress])
  @@index([agentAddress])
  @@index([status])
}

model Leg {
  id           String @id @default(cuid())
  intentId     String
  intent       Intent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  recipientCvi String
  amount       String // base units, decimal STRING
  sequence     Int
  status       String // PENDING|RELEASED|ISOLATED|FROZEN|QUARANTINED

  releasedAt DateTime?
  txHash     String? // on-chain settlement hash, for explorer links + travel rule

  @@index([intentId])
  @@index([recipientCvi])
  @@index([status])
}

/// APPEND-ONLY. The compliance record. Never updated, never deleted.
/// Point-in-time export = replay events up to timestamp T.
model AuditEvent {
  id       String  @id @default(cuid())
  intentId String?
  intent   Intent? @relation(fields: [intentId], references: [id], onDelete: Cascade)
  legId    String?

  eventType String // CHECK_RUN|RELEASE|FREEZE|ISOLATE|REVOCATION|YIELD_ACCRUAL
  trigger   String? // INTENT_CREATE|MILESTONE_RELEASE|BATCH_ADDRESS|SUBSCRIPTION_EPOCH|LINK_OPEN|YIELD_TICK
  verdict   String? // PASS|FAIL|ISOLATE|FREEZE
  reasonCode String?

  /// All four check outcomes, individually. JSON-encoded string (SQLite).
  checkResults String
  /// Arbitrary context for the event. JSON-encoded string (SQLite).
  payload      String

  occurredAt DateTime @default(now())

  @@index([intentId])
  @@index([occurredAt])
  @@index([eventType])
}
